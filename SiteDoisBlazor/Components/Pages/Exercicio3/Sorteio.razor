@page "/sorteio"
@rendermode InteractiveServer

<PageTitle>Sorteador de Números</PageTitle>

<div class="cartao">
    <h1>Sorteador de Números</h1>
    <p>Clique no botão para sortear um número entre 1 e 100.</p>

    <button class="botao-principal" @onclick="SorteiaNumero">Gerar Número Aleatório</button>

    @if (numeroSorteado.HasValue)
    {
        <div class="numero-sorteado">
            <span>Número sorteado:</span>
            <h2>@numeroSorteado</h2>
        </div>
    }
</div>

@code {
    private int? numeroSorteado;
    private readonly Random random = new();

    private void SorteiaNumero()
    {
        numeroSorteado = random.Next(1, 101);
    }
}
