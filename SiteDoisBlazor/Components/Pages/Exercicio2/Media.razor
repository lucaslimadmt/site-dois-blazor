@page "/media"
@rendermode InteractiveServer

<PageTitle>Calculadora de Média</PageTitle>

<div class="cartao">
    <h1>Calculadora de Média</h1>
    <p>Informe as duas notas do aluno para calcular a média.</p>

    <div class="campo-formulario">
        <label for="nota1">Nota 1:</label>
        <input id="nota1" type="number" min="0" max="10" step="0.1" @bind="nota1" />
    </div>

    <div class="campo-formulario">
        <label for="nota2">Nota 2:</label>
        <input id="nota2" type="number" min="0" max="10" step="0.1" @bind="nota2" />
    </div>

    <button class="botao-principal" @onclick="CalcularMedia">Calcular Média</button>

    @if (media.HasValue)
    {
        <div class="resultado">
            <p>Média: <strong>@media.Value.ToString("F1")</strong></p>

            @if (media >= 7.0)
            {
                <p class="aprovado"><strong>Aprovado!</strong></p>
            }
            else
            {
                <p class="reprovado"><strong>Reprovado!</strong></p>
            }
        </div>
    }
</div>

@code {
    private double nota1;
    private double nota2;
    private double? media;

    private void CalcularMedia()
    {
        media = (nota1 + nota2) / 2;
    }
}
